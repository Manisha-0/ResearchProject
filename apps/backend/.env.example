APP_NAME=Project Compass API
APP_ENV=development
DEBUG=true

DATABASE_URL=postgresql+psycopg://YOUR_SUPABASE_CONNECTION_STRING
SUPABASE_STORAGE_BUCKET=compass
SUPABASE_S3_ENDPOINT=https://YOUR_PROJECT_REF.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=YOUR_REGION
SUPABASE_S3_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
SUPABASE_S3_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY

FRONTEND_URL=http://localhost:3000

JWT_SECRET_KEY=replace-this-later-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

BOOTSTRAP_ADMIN_EMAIL=admin@compass.demo
BOOTSTRAP_ADMIN_PASSWORD=replace-me

BOOTSTRAP_ORGANIZATION_NAME=Compass Demo Health System
BOOTSTRAP_ORGANIZATION_SLUG=compass-demo

BOOTSTRAP_ADMIN_EMAIL=admin@compass.demo
BOOTSTRAP_ADMIN_PASSWORD=replace-me

ACCOUNT_INVITATION_EXPIRE_HOURS=24
ACTIVATION_URL=http://localhost:3000/activate
EMAIL_PROVIDER=console

GEMINI_API_KEY=your_real_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
DOCUMENT_SUMMARY_MAX_CHARACTERS=100000

EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_real_key
RESEND_FROM_EMAIL=Compass <onboarding@resend.dev>

ACTIVATION_URL=http://localhost:3000/activate